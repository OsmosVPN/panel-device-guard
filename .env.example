# Base panel URL (http/https)
PANEL_BASE_URL=http://127.0.0.1:8000
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me

# Device limit rule: device_limit + EXTRA_DEVICES
EXTRA_DEVICES=0

# Sliding window to count unique source IP per user
ACTIVE_WINDOW_SECONDS=600

# Require N consecutive violations before block
VIOLATION_THRESHOLD=3

# Block duration in seconds
BLOCK_TTL_SECONDS=1800

# Main evaluation loop interval
CHECK_INTERVAL_SECONDS=10

# Node logs websocket polling interval (accepted by panel API, <=10)
NODE_LOGS_INTERVAL=1

# If true, disable TLS verification for API/WS

# Optional: strip prefixes from email field in logs.
# Example log email: "8.test1" -> "test1"
EMAIL_TO_USERNAME_REGEX=(?:\d+\.)?(?P<username>.+)

# Marker prefix stored in user note to track temporary blocks
NOTE_MARKER_PREFIX=[DGUARD]

# Comma-separated whitelist for users (never block)
WHITELIST_USERNAMES=

# Comma-separated source IP whitelist (ignored in counting)
WHITELIST_IPS=

# Dry-run mode (logs block/unlock actions without applying PUT /api/user/{username})
DRY_RUN=false

# Web UI bind
WEB_HOST=0.0.0.0
WEB_PORT=8088

# Web UI auth
WEB_USERNAME=guard
WEB_PASSWORD=change-me

# TTL for manual ban from UI (seconds)
MANUAL_BLOCK_TTL_SECONDS=1800

# Optional: webhook URL called on ban/unban events
# WEBHOOK_URL=https://example.com/hooks/device-guard
# Optional: HMAC-SHA256 signing secret (sets X-Signature: sha256=... header)
# WEBHOOK_SECRET=
